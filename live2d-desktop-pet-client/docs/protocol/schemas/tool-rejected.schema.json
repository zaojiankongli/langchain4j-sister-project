{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live2d-desktop-pet.local/protocol/pet-ws-v1/tool.rejected.schema.json",
  "title": "tool.rejected",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "toolCallId",
    "reason"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "type": {
      "const": "tool.rejected"
    },
    "toolCallId": {
      "$ref": "./envelope.schema.json#/$defs/toolCallId"
    },
    "reason": {
      "type": "string",
      "enum": [
        "user_rejected",
        "permission_denied",
        "timeout"
      ]
    }
  }
}

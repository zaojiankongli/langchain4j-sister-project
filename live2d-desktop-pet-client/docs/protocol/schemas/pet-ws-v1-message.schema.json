{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live2d-desktop-pet.local/protocol/pet-ws-v1/message.schema.json",
  "title": "Pet WebSocket v1 Message",
  "oneOf": [
    {
      "$ref": "./user-message.schema.json"
    },
    {
      "$ref": "./assistant-message-delta.schema.json"
    },
    {
      "$ref": "./assistant-message-done.schema.json"
    },
    {
      "$ref": "./pet-expression.schema.json"
    },
    {
      "$ref": "./pet-motion.schema.json"
    },
    {
      "$ref": "./tool-request.schema.json"
    },
    {
      "$ref": "./tool-confirmed.schema.json"
    },
    {
      "$ref": "./tool-rejected.schema.json"
    },
    {
      "$ref": "./error.schema.json"
    }
  ]
}

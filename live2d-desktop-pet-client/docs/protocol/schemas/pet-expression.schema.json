{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live2d-desktop-pet.local/protocol/pet-ws-v1/pet.expression.schema.json",
  "title": "pet.expression",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "expression"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "type": {
      "const": "pet.expression"
    },
    "expression": {
      "$ref": "./envelope.schema.json#/$defs/semanticExpression"
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    }
  }
}

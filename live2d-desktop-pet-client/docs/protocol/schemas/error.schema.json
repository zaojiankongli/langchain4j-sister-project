{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live2d-desktop-pet.local/protocol/pet-ws-v1/error.schema.json",
  "title": "error",
  "allOf": [
    {
      "$ref": "./envelope.schema.json"
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "code",
    "message"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "type": {
      "const": "error"
    },
    "code": {
      "$ref": "./envelope.schema.json#/$defs/errorCode"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "details": {
      "type": "object"
    }
  }
}
